# Аналитика (ТЗ, раздел 2). Задаются при сборке; без них скрипты счётчиков не подключаются.
# Яндекс Метрика: номер счётчика
VITE_YM_ID=
# Google Analytics 4: идентификатор потока, вида G-XXXXXXXXXX
VITE_GA_ID=

# Подтверждение прав в кабинетах вебмастеров (метод «мета-тег»). Пусто — тег не выводится.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_YANDEX_VERIFICATION=
VITE_BING_VERIFICATION=
